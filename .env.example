# Labs runs on this key, which needs the files, parsing, stores and search
# scopes. Use an organization of its own: anything the key reaches is open to
# whoever has its link.
MXBAI_API_KEY=

# Chat runs GPT-5.6 Terra through the Vercel AI Gateway; on Vercel the
# deployment's OIDC token stands in for it
AI_GATEWAY_API_KEY=

# Another API host for the SDK, such as a local one (default: https://api.mixedbread.com)
# MIXEDBREAD_BASE_URL=http://localhost:8000

# Signs the token each upload, parse and chat gets, which lets only the
# browser that made it delete it. Any long random string; without it, nothing
# can be deleted. Make one with: openssl rand -base64 32
OWNER_TOKEN_SECRET=
